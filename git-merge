#!/usr/bin/env bash
set -euo pipefail

# @description 输出步骤日志，便于定位执行进度
# @param $1 步骤编号
# @param $2 步骤说明
# @returns 无
step() {
  printf '\n步骤%s: %s\n' "$1" "$2"
}

# @description 输出错误信息并退出
# @param $1 错误描述
# @returns 无
fail() {
  printf '错误: %s\n' "$1" >&2
  exit 1
}

# @description 输出脚本帮助信息
# @param 无
# @returns 无
print_help() {
  cat <<'EOF'
用法:
  ./git-merge <远端基线分支a> <远端来源分支b>
  ./git-merge <远端来源分支a> <本地目标分支b> <远端基线分支c>

说明:
  传 2 个参数时：基于最新 origin/a 创建或重建本地 a，再把最新 origin/b 合并到 a。
  传 3 个参数时：先删除本地 b、c，再基于最新 origin/c 创建本地 b，最后把最新 origin/a 合并到 b。
  传 3 个参数时，如果 origin/b 已存在则取消执行；本地 b、c 存在时会被强制删除。
  如果远端基线分支或远端来源分支不存在，则取消执行。

原理:
  先同步远端引用，再以远端基线分支作为可信基线创建本地目标分支，
  最后把远端来源分支合并进目标分支，避免依赖当前本地分支状态。
EOF
}

# @description 校验当前目录是否位于 Git 仓库内
# @param 无
# @returns 校验失败时直接退出
ensure_git_repo() {
  git rev-parse --is-inside-work-tree >/dev/null 2>&1 || fail "当前目录不是 Git 仓库"
}

# @description 校验已跟踪文件是否干净，忽略未跟踪文件，避免切换分支和合并时夹带未提交改动
# @param 无
# @returns 校验失败时直接退出
ensure_clean_worktree() {
  if [[ -n "$(git status --porcelain --untracked-files=no)" ]]; then
    fail "检测到已跟踪文件存在未提交改动，请先提交或 stash 后再执行"
  fi
}

# @description 校验远端目标分支是否存在
# @param $1 远端分支引用
# @returns 校验失败时直接退出
ensure_remote_branch_exists() {
  local remote_branch_ref="$1"
  git show-ref --verify --quiet "refs/remotes/${remote_branch_ref}" || fail "远端分支 ${remote_branch_ref} 不存在"
}

# @description 校验远端目标分支不存在，避免覆盖已有远端分支语义
# @param $1 远端分支引用
# @returns 校验失败时直接退出
ensure_remote_branch_absent() {
  local remote_branch_ref="$1"
  if git show-ref --verify --quiet "refs/remotes/${remote_branch_ref}"; then
    fail "远端目标分支 ${remote_branch_ref} 已存在，已取消执行"
  fi
}

# @description 删除本地分支（分支不存在时跳过）
# @param $1 本地分支名
# @returns 无
delete_local_branch_if_exists() {
  local branch_name="$1"

  if git show-ref --verify --quiet "refs/heads/${branch_name}"; then
    git branch -D -- "${branch_name}"
  fi
}

first_branch="${1:-}"
base_branch=""
target_branch=""
source_branch=""
remote_name="origin"
base_remote_ref=""
source_remote_ref=""

if [[ "${first_branch}" == "-h" || "${first_branch}" == "--help" || "${first_branch}" == "help" ]]; then
  print_help
  exit 0
fi

if [[ -z "${first_branch}" || -z "${2:-}" ]]; then
  print_help >&2
  exit 1
fi

case "$#" in
  2)
    base_branch="${first_branch}"
    target_branch="${base_branch}"
    source_branch="$2"
    ;;
  3)
    source_branch="${first_branch}"
    target_branch="$2"
    base_branch="$3"
    ;;
  *)
    print_help >&2
    exit 1
    ;;
esac

if [[ "$#" -eq 3 && ("${target_branch}" == "${base_branch}" || "${target_branch}" == "${source_branch}") ]]; then
  fail "本地目标分支不能与远端基线分支或远端来源分支同名"
fi

ensure_git_repo

step 1 "校验仓库状态与输入参数"
ensure_clean_worktree

step 2 "同步远端分支引用"
git fetch --all --prune
base_remote_ref="${remote_name}/${base_branch}"
source_remote_ref="${remote_name}/${source_branch}"
ensure_remote_branch_exists "${base_remote_ref}"
ensure_remote_branch_exists "${source_remote_ref}"
if [[ "$#" -eq 3 ]]; then
  ensure_remote_branch_absent "${remote_name}/${target_branch}"
fi

if [[ "$#" -eq 3 ]]; then
  step 3 "删除本地 ${target_branch} 和 ${base_branch}"
  git checkout --detach "${base_remote_ref}"
  delete_local_branch_if_exists "${target_branch}"
  delete_local_branch_if_exists "${base_branch}"

  step 4 "基于最新 ${base_remote_ref} 创建本地 ${target_branch}"
  git checkout --no-track -b "${target_branch}" "${base_remote_ref}"
else
  step 3 "基于最新 ${base_remote_ref} 创建或重建本地 ${target_branch}"
  git checkout --detach "${base_remote_ref}"
  git checkout -B "${target_branch}"
fi

step 5 "合并最新 ${source_remote_ref} 到 ${target_branch}"
if ! git merge --no-edit "${source_remote_ref}"; then
  fail "合并 ${source_remote_ref} 到 ${target_branch} 失败，请解决冲突后再继续"
fi

printf '\n完成: 已基于最新 %s 创建本地分支 %s，并合并最新 %s\n' \
  "${base_remote_ref}" \
  "${target_branch}" \
  "${source_remote_ref}"
